# Any OpenAI-compatible endpoint: OpenRouter, Ollama, vLLM, LM Studio, Together, Groq, ...
# Copy to .env.local and fill in (never commit .env.local). Without AI_API_KEY the Ask AI button stays hidden.

# Base URL of the chat completions endpoint (required when AI_API_KEY is set)
AI_BASE_URL=https://openrouter.ai/api/v1
# Ollama local:   AI_BASE_URL=http://localhost:11434/v1
# vLLM server:    AI_BASE_URL=http://localhost:8000/v1

# Key for the endpoint: OpenRouter key from https://openrouter.ai/keys,
# or anything (e.g. "ollama") for local servers
AI_API_KEY=

# Model id as exposed by the endpoint
AI_MODEL=meta-llama/llama-3.1-8b-instruct:free