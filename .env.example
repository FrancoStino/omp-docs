# Copy to .env.local and fill in (never commit .env.local)
# Enables the Ask AI chat on the docs site. Without a key the button stays hidden.

# --- Option A: OpenRouter (default, free tier) ---
# Get a key free at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Option B: any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, Together, Groq, ...) ---
# When AI_BASE_URL is set it wins over OpenRouter. Examples:
# Ollama local:      AI_BASE_URL=http://localhost:11434/v1
# vLLM server:       AI_BASE_URL=http://localhost:8000/v1
# Any other service: AI_BASE_URL=https://api.together.xyz/v1
AI_BASE_URL=
# Key for the custom endpoint (Ollama can use anything, e.g. "ollama")
AI_API_KEY=
# Model id as exposed by the custom endpoint (e.g. "llama3.1:8b" on Ollama)
AI_MODEL=
